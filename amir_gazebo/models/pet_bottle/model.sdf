<?xml version="1.0"?>
<sdf version="1.7">

  <model name="pet_bottle">

    <!-- 動かせる物体 -->
    <static>false</static>

    <link name="bottle_link">

      <!-- モデル原点はボトル底面の中心 -->
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>

      <!-- ====================================================== -->
      <!-- 慣性 -->
      <!-- ====================================================== -->

      <inertial>

        <!-- 重心位置 -->
        <pose>0 0 0.105 0 0 0</pose>

        <!-- 500 mLのペットボトルを想定 -->
        <mass>0.12</mass>

        <inertia>
          <ixx>5.6e-4</ixx>
          <iyy>5.6e-4</iyy>
          <izz>7.0e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <!-- ====================================================== -->
      <!-- Collision：計算を軽くするため単純形状を使用 -->
      <!-- ====================================================== -->

      <!-- 底面。広い接地面でスポーン直後の横倒しを防ぐ。 -->
      <collision name="bottom_collision">
        <pose>0 0 0.008 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 胴体 -->
      <collision name="body_collision">
        <pose>0 0 0.0875 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.165</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 肩部分 -->
      <collision name="shoulder_collision">
        <pose>0 0 0.180 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.029</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- 首部分 -->
      <collision name="neck_collision">
        <pose>0 0 0.205 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.014</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- キャップ -->
      <collision name="cap_collision">
        <pose>0 0 0.225 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.017</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- ====================================================== -->
      <!-- Visual：ボトル本体 -->
      <!-- ====================================================== -->

      <!-- 底部 -->
      <visual name="bottom_visual">
        <pose>0 0 0.008 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.30 0.70 1.0</ambient>
          <diffuse>0.08 0.52 0.95 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <!-- 胴体 -->
      <visual name="body_visual">
        <pose>0 0 0.088 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.160</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.30 0.70 1.0</ambient>
          <diffuse>0.08 0.52 0.95 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>

        <!-- YOLOが輪郭を捉えやすい不透明な本体。 -->
        <transparency>0.0</transparency>
      </visual>

      <!-- ====================================================== -->
      <!-- 胴体の凹凸リング -->
      <!-- ====================================================== -->

      <visual name="lower_ring_1">
        <pose>0 0 0.027 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0350</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.02 0.14 0.42 1.0</ambient>
          <diffuse>0.03 0.28 0.72 1.0</diffuse>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <visual name="lower_ring_2">
        <pose>0 0 0.043 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0350</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.02 0.14 0.42 1.0</ambient>
          <diffuse>0.03 0.28 0.72 1.0</diffuse>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <visual name="upper_body_ring">
        <pose>0 0 0.157 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0348</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.02 0.14 0.42 1.0</ambient>
          <diffuse>0.03 0.28 0.72 1.0</diffuse>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <!-- ====================================================== -->
      <!-- ラベル -->
      <!-- ====================================================== -->

      <!-- 緑を基調としたラベル本体 -->
      <visual name="label_visual">
        <pose>0 0 0.105 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0347</radius>
            <length>0.056</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.30 0.08 1.0</ambient>
          <diffuse>0.06 0.68 0.16 1.0</diffuse>
          <specular>0.15 0.15 0.15 1.0</specular>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <!-- ラベル下側の濃緑帯 -->
      <visual name="label_lower_band">
        <pose>0 0 0.080 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0350</radius>
            <length>0.007</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.01 0.10 0.03 1.0</ambient>
          <diffuse>0.02 0.28 0.06 1.0</diffuse>
        </material>
      </visual>

      <!-- 緑地上で形を読み取りやすくする白いロゴ帯 -->
      <visual name="label_center_band">
        <pose>0 0 0.105 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0350</radius>
            <length>0.014</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.88 0.96 0.88 1.0</ambient>
          <diffuse>0.96 1.00 0.96 1.0</diffuse>
          <specular>0.15 0.15 0.15 1.0</specular>
        </material>
      </visual>

      <!-- ラベル上側の黄色いアクセント帯 -->
      <visual name="label_red_band">
        <pose>0 0 0.130 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0350</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.62 0.48 0.02 1.0</ambient>
          <diffuse>0.96 0.78 0.04 1.0</diffuse>
        </material>
      </visual>

      <!-- ====================================================== -->
      <!-- 肩部分：段階的に細くする -->
      <!-- ====================================================== -->

      <visual name="shoulder_lower_visual">
        <pose>0 0 0.172 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.30 0.70 1.0</ambient>
          <diffuse>0.08 0.52 0.95 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <visual name="shoulder_middle_visual">
        <pose>0 0 0.184 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.026</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.30 0.70 1.0</ambient>
          <diffuse>0.08 0.52 0.95 1.0</diffuse>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <visual name="shoulder_upper_visual">
        <pose>0 0 0.193 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.30 0.70 1.0</ambient>
          <diffuse>0.08 0.52 0.95 1.0</diffuse>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <!-- 首の付け根リング -->
      <visual name="neck_ring_visual">
        <pose>0 0 0.198 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.22 0.58 1.0</ambient>
          <diffuse>0.06 0.42 0.88 1.0</diffuse>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <!-- 首 -->
      <visual name="neck_visual">
        <pose>0 0 0.208 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.014</radius>
            <length>0.024</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.30 0.70 1.0</ambient>
          <diffuse>0.08 0.52 0.95 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>

        <transparency>0.0</transparency>
      </visual>

      <!-- ====================================================== -->
      <!-- キャップ -->
      <!-- ====================================================== -->

      <visual name="cap_visual">
        <pose>0 0 0.225 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.017</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.01 0.06 0.40 1.0</ambient>
          <diffuse>0.02 0.16 0.90 1.0</diffuse>
          <specular>0.25 0.25 0.25 1.0</specular>
        </material>
      </visual>

      <!-- キャップの溝をリングで表現 -->
      <visual name="cap_ring_lower">
        <pose>0 0 0.219 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0175</radius>
            <length>0.0025</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.01 0.04 0.30 1.0</ambient>
          <diffuse>0.01 0.10 0.65 1.0</diffuse>
        </material>
      </visual>

      <visual name="cap_ring_middle">
        <pose>0 0 0.225 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0175</radius>
            <length>0.0025</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.01 0.04 0.30 1.0</ambient>
          <diffuse>0.01 0.10 0.65 1.0</diffuse>
        </material>
      </visual>

      <visual name="cap_ring_upper">
        <pose>0 0 0.231 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.0175</radius>
            <length>0.0025</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.01 0.04 0.30 1.0</ambient>
          <diffuse>0.01 0.10 0.65 1.0</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>
