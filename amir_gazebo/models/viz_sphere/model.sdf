<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='viz_sphere'>
    <!-- 順運動学EE位置を示す表示専用モデル -->
    <static>true</static>
    <link name='link'>
      <pose>0 0 0 0 0 0</pose>
      <visual name='visual'>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
